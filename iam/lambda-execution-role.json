{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteCloudWatchLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:REGION:123456789012:log-group:/aws/lambda/ServiceDeskHandler:*"
    }
  ]
}
